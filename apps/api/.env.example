# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truzon?schema=public"

# JWT
JWT_SECRET_KEY="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# SMTP (optional for development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@truzonhomes.com
SMTP_FROM_NAME=Truzon Homes

# Storage (GCS, R2, or LOCAL)
STORAGE_PROVIDER=LOCAL
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
LOCAL_UPLOAD_DIR=./uploads
LOCAL_PUBLIC_URL=http://localhost:3000/media-files

# Push Notifications
FIREBASE_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Frontend URLs
ADMIN_URL=http://localhost:3001
PUBLIC_URL=http://localhost:3000
PRO_CP_URL=http://localhost:3002

# Features
ENABLE_2FA=false
ENABLE_PUBLIC_API=true
ENABLE_WEBHOOKS=false